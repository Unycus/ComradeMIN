<Page x:Class="ComradeMIN.UserDataBaseMessengePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ComradeMIN"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="1000"
      Title="UserDataBaseMessengePage">
    <Grid Margin="5,5,5,5">
        <Border Background="White" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" Width="190" Height="50">
            <TextBox x:Name="ID_search" Background="Transparent" BorderThickness="0" FontSize="12" Padding="4" MaxLines="1"/>
        </Border>
        <Border Background="White" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" Width="580" Height="50" Margin="330,403,0,0">
            <TextBox x:Name="Text_for_Comrade" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="12" Padding="4" MaxLines="99" TextChanged="Text_for_Comrade_TextChanged"/>
        </Border>
        <Border Background="White" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" Width="580" Height="50" Margin="330,0,0,0">
            <Label x:Name="Comrade_information" Background="Transparent" VerticalContentAlignment="Center" BorderThickness="0" FontSize="18" Padding="4" Margin="0,-10,0,-10"/>
        </Border>
        <Border Background="#800000" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" Width="250" Height="395" Margin="0,55,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Fellows" Width="250"/>
            </ScrollViewer>
        </Border>
        <Border Background="#800000" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" Width="50" Height="50" Margin="270,0,0,0">
            
        </Border>
        <Button x:Name="Enter_to_search" Content="🔎" HorizontalAlignment="Left" Margin="200,0,0,0" VerticalAlignment="Top" Height="50" Width="50"
    Background="Transparent"
    BorderThickness="0"
    Foreground="#B8860B"
    FontSize="16"
    MouseEnter="Enter_to_search_MouseEnter"
    MouseLeave="Enter_to_search_MouseLeave" 
        Click="Enter_to_search_Click">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Rectangle x:Name="Oval_ID_search"
                    Fill="#800000"
                    StrokeThickness="0"
                    RadiusX="8"
                    RadiusY="8"
                    RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button x:Name="Enter_Text" Content="⏎" HorizontalAlignment="Left" Margin="920,0,0,0" VerticalAlignment="Bottom" Height="50" Width="50"
Background="Transparent"
BorderThickness="0"
Foreground="#B8860B"
FontSize="20"
MouseEnter="Enter_text_MouseEnter"
MouseLeave="Enter_text_MouseLeave" 
Click="Enter_Text_Click"
Focusable="False">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Rectangle x:Name="Oval_Text"
                Fill="#800000"
                StrokeThickness="0"
                RadiusX="8"
                RadiusY="8"
                RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button x:Name="Enter_to_Options" Content="⚙️" HorizontalAlignment="Left" Margin="920,0,0,0" VerticalAlignment="Top" Height="50" Width="50"
    Background="Transparent"
    BorderThickness="0"
    Foreground="#B8860B"
    FontSize="16"
    MouseEnter="Enter_to_Options_MouseEnter"
    MouseLeave="Enter_to_Options_MouseLeave" 
        Click="Enter_to_Options_Click">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Rectangle x:Name="Oval_Options"
                    Fill="#800000"
                    StrokeThickness="0"
                    RadiusX="8"
                    RadiusY="8"
                    RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Border Background="White" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" Width="50" Height="50" Margin="270,403,0,0">
            <Button x:Name="FileText" Content="📎" Background="Transparent" BorderThickness="0" Foreground="#B8860B"
            FontSize="20" Click="FileText_Click"
            MouseEnter="FileText_MouseEnter" MouseLeave="FileText_MouseLeave">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Rectangle x:Name="Oval_FileText"
                        Fill="#800000"
                        StrokeThickness="0"
                        RadiusX="8"
                        RadiusY="8"
                        RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>
        <ScrollViewer x:Name="MessagesScrollViewer" Margin="270,55,10,50" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Reports"/>
        </ScrollViewer>
    </Grid>
</Page>