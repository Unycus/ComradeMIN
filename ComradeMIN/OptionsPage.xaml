<Page x:Class="ComradeMIN.OptionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ComradeMIN"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="1000"
      Title="OptionsPage"
      Background="#383838">

    <Grid>
        <Border Background="#696969" CornerRadius="8" Margin="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="#800000" CornerRadius="8,8,0,0" Padding="20">
                    <TextBlock Text="НАСТРОЙКИ ПРОФИЛЯ" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="#B8860B"
                               HorizontalAlignment="Center"/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <Border Width="200" Height="200" 
                                    Background="White" 
                                    BorderBrush="#800000" 
                                    BorderThickness="2"
                                    CornerRadius="100"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,20">
                                <Grid>
                                    <Image x:Name="ProfileImageControl" 
                                           Stretch="UniformToFill" Margin="-1,-1,1,1">
                                        <Image.Clip>
                                            <EllipseGeometry Center="100,100" 
                                                           RadiusX="98" 
                                                           RadiusY="98"/>
                                        </Image.Clip>
                                    </Image>

                                    <TextBlock x:Name="DefaultAvatarText"
                                               Text="👤"
                                               FontSize="80"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Visible"/>
                                </Grid>
                            </Border>

                            <StackPanel>
                                <Button x:Name="ChangeImageBtn" 
                                        Content="Сменить аватар" 
                                        Click="ChangeImageBtn_Click"
                                        Height="35"
                                        Background="#800000"
                                        Foreground="#B8860B"
                                        BorderThickness="0"
                                        FontSize="14"
                                        Margin="0,0,0,10">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="RemoveImageBtn" 
                                        Content="Удалить аватар" 
                                        Click="RemoveImageBtn_Click"
                                        Height="35"
                                        Background="#9E9E9E"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontSize="14">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <Border Background="White" 
                                    CornerRadius="8" 
                                    Padding="15"
                                    Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="СТАТИСТИКА" 
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Margin="0,0,0,10"
                                               Foreground="#333"/>

                                    <StackPanel>
                                        <TextBlock>
                                            <Run Text="ID:" FontWeight="Bold"/>
                                            <Run x:Name="UserIdText"/>
                                        </TextBlock>

                                        <Separator Margin="0,5,0,5"/>

                                        <TextBlock>
                                            <Run Text="Регистрация:" FontWeight="Bold"/>
                                            <Run x:Name="CreatedDateText"/>
                                        </TextBlock>

                                        <Separator Margin="0,5,0,5"/>

                                        <TextBlock>
                                            <Run Text="Последний вход:" FontWeight="Bold"/>
                                            <Run x:Name="LastLoginText"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="ОСНОВНАЯ ИНФОРМАЦИЯ" 
                                               FontWeight="Bold"
                                               FontSize="16"
                                               Margin="0,0,0,15"
                                               Foreground="#333"/>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                                   Text="Имя пользователя:"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,10"/>
                                        <Border Grid.Row="0" Grid.Column="1" 
                                                Background="#F5F5F5" 
                                                CornerRadius="5"
                                                Margin="0,0,0,10">
                                            <TextBox x:Name="UserNameTextBox" 
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Padding="10"
                                                     FontSize="14"
                                                     MaxLength="50"/>
                                        </Border>

                                        <TextBlock Grid.Row="1" Grid.Column="0" 
                                                   Text="Email:"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,10"/>
                                        <Border Grid.Row="1" Grid.Column="1" 
                                                Background="#F5F5F5" 
                                                CornerRadius="5"
                                                Margin="0,0,0,10">
                                            <TextBox x:Name="EmailTextBox" 
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Padding="10"
                                                     FontSize="14"
                                                     MaxLength="100"/>
                                        </Border>

                                        <TextBlock Grid.Row="2" Grid.Column="0" 
                                                   Text="Статус:"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,10"/>
                                        <Border Grid.Row="2" Grid.Column="1" 
                                                Background="#F5F5F5" 
                                                CornerRadius="5"
                                                Margin="0,0,0,10">
                                            <ComboBox x:Name="StatusComboBox"
                                                      BorderThickness="0"
                                                      Background="Transparent"
                                                      Padding="10"
                                                      FontSize="14"
                                                      SelectedIndex="0">
                                                <ComboBoxItem Content="В сети" Tag="online"/>
                                                <ComboBoxItem Content="Не беспокоить" Tag="dnd"/>
                                                <ComboBoxItem Content="Отошел" Tag="away"/>
                                                <ComboBoxItem Content="Не в сети" Tag="offline"/>
                                            </ComboBox>
                                        </Border>

                                        <TextBlock Grid.Row="3" Grid.Column="1" 
                                                   x:Name="AvatarSizeInfo"
                                                   FontSize="11"
                                                   Foreground="Gray"
                                                   Text="Максимальный размер аватара: 2 MB"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="СМЕНА ПАРОЛЯ" 
                                               FontWeight="Bold"
                                               FontSize="16"
                                               Margin="0,0,0,15"
                                               Foreground="#333"/>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                                   Text="Текущий пароль:"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,10"/>
                                        <Border Grid.Row="0" Grid.Column="1" 
                                                Background="#F5F5F5" 
                                                CornerRadius="5"
                                                Margin="0,0,0,10">
                                            <PasswordBox x:Name="CurrentPasswordBox" 
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Padding="10"
                                                         FontSize="14"/>
                                        </Border>

                                        <TextBlock Grid.Row="1" Grid.Column="0" 
                                                   Text="Новый пароль:"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,10"/>
                                        <Border Grid.Row="1" Grid.Column="1" 
                                                Background="#F5F5F5" 
                                                CornerRadius="5"
                                                Margin="0,0,0,10">
                                            <PasswordBox x:Name="NewPasswordBox" 
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Padding="10"
                                                         FontSize="14"/>
                                        </Border>

                                        <TextBlock Grid.Row="2" Grid.Column="0" 
                                                   Text="Подтверждение:"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,10"/>
                                        <Border Grid.Row="2" Grid.Column="1" 
                                                Background="#F5F5F5" 
                                                CornerRadius="5"
                                                Margin="0,0,0,10">
                                            <PasswordBox x:Name="ConfirmPasswordBox" 
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Padding="10"
                                                         FontSize="14"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock x:Name="PasswordChangeMessage"
                                               FontSize="12"
                                               Margin="0,10,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="2" 
                        Background="White" 
                        CornerRadius="0,0,8,8" 
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="SaveMessage"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="#800000"
                                   Visibility="Collapsed"/>

                        <Button x:Name="CancelBtn" 
                                Grid.Column="1"
                                Content="Отмена" 
                                Click="CancelBtn_Click" 
                                Width="120" 
                                Height="40"
                                Margin="0,0,10,0" 
                                Background="#9E9E9E"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="14">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="SaveBtn" 
                                Grid.Column="2"
                                Content="Сохранить" 
                                Click="SaveBtn_Click" 
                                Width="120" 
                                Height="40"
                                Background="#800000" 
                                Foreground="#B8860B"
                                BorderThickness="0"
                                FontSize="14">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>