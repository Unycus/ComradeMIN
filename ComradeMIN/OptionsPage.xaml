<Page x:Class="ComradeMIN.OptionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="OptionsPage" Height="600" Width="800">
    <Grid Background="#F5F5F5" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Настройки профиля" FontSize="24" FontWeight="Bold" 
                   Foreground="#333333" Margin="0,0,0,20"/>

        <!-- Основной контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Блок с аватаром -->
                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Аватар профиля" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="100" Height="100" CornerRadius="50" Background="LightGray" 
                                    BorderBrush="#DDDDDD" BorderThickness="2">
                                <Image x:Name="ProfileImageControl" Stretch="UniformToFill">
                                    <Image.Clip>
                                        <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50"/>
                                    </Image.Clip>
                                </Image>
                            </Border>
                            <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                                <Button x:Name="ChangeImageBtn" Content="Сменить аватар" 
                                        Click="ChangeImageBtn_Click" Width="120" Margin="0,0,0,5"/>
                                <Button x:Name="RemoveImageBtn" Content="Удалить аватар" 
                                        Click="RemoveImageBtn_Click" Width="120" 
                                        Background="LightCoral" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Информация о пользователе -->
                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Основная информация" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ID пользователя -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ID пользователя:" 
                                      VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="UserIdTextBox" 
                                    IsReadOnly="True" Background="#F0F0F0" Margin="0,0,0,10"/>

                            <!-- Имя пользователя -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Имя пользователя:" 
                                      VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="UserNameTextBox" 
                                    MaxLength="50" Margin="0,0,0,10"/>

                            <!-- Статус -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Статус:" 
                                      VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="StatusComboBox" 
                                     Margin="0,0,0,10">
                                <ComboBoxItem Content="В сети"/>
                                <ComboBoxItem Content="Не беспокоить"/>
                                <ComboBoxItem Content="Отошел"/>
                                <ComboBoxItem Content="Не в сети"/>
                            </ComboBox>

                            <!-- Email -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Email:" 
                                      VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="EmailTextBox" 
                                    Margin="0,0,0,10"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Статистика -->
                <Border Background="White" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Статистика" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Дата регистрации:" 
                                      FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CreatedDateText" 
                                      Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Последний вход:" 
                                      FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LastLoginText" 
                                      Margin="0,0,0,10"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки действий -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="15" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Content="Отмена" Click="CancelBtn_Click" 
                        Width="100" Margin="0,0,10,0" Background="LightGray"/>
                <Button x:Name="SaveBtn" Content="Сохранить" Click="SaveBtn_Click" 
                        Width="100" Background="#4CAF50" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>